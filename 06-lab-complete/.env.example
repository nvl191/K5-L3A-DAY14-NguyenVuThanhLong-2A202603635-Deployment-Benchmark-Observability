# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Không ghi secret thật vào file này.

PORT=8000
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Chạy bằng Docker Compose thì giá trị này được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
